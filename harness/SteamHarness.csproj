<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>SteamHarness</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/GoingMultiplayer/SessionProtocol.cs" Link="SessionProtocol.cs" />
    <Compile Include="../src/GoingMultiplayer/SteamP2PTransport.cs" Link="SteamP2PTransport.cs" />
    <Compile Include="../src/GoingMultiplayer/SteamLobbyService.cs" Link="SteamLobbyService.cs" />
    <Reference Include="Facepunch.Steamworks.Win64">
      <HintPath>../local/test-install/Going Under_Data/Managed/Facepunch.Steamworks.Win64.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
